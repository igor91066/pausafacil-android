<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_snackbar">

    <!-- CABEÇALHO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MENSAGEM SELECIONADA"
            android:textColor="#BFDBFE"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMessageCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_snackbar_counter"
            android:text="01 / 10"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- MENSAGEM -->

    <TextView
        android:id="@+id/txtSnackbarMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:text="Quero água"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- PROGRESSO -->

    <ProgressBar
        android:id="@+id/messageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="10"
        android:progress="1"
        android:progressTint="#93C5FD"
        android:progressBackgroundTint="#405477"
        android:layout_marginBottom="10dp" />

    <!-- INSTRUÇÃO -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toque novamente para ver outra frase"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

</LinearLayout>